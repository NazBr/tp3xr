#usda 1.0
(
    defaultPrim = "Forest"
    metersPerUnit = 1
    upAxis = "Y"
)

# TP3 - Composition dune foret structuree avec OpenUSD
# Version corrigee : 1681 plaques Ground assets, grille diagonale resserree, aucune surface continue generee.
# La scene conserve trois zones lisibles : foret dense, clairiere et chemin naturel.

def Xform "Forest" (
    customData = {
        string theme = "Foret low-poly compacte avec foret dense, clairiere centrale et chemin naturel"
        string ground_policy = "1681 referenced ground tiles only; no continuous floor mesh"
        string placement_note = "Ground tiles use a staggered diagonal 41 x 41 grid with row offsets in X and Z, 3.35/3.10 unit spacing, to close diagonal holes. Path ground tiles are rotated by 90 degrees to visually connect the path."
    }
)
{
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Xform "Environment"
    {
        def Xform "Ground" (
            customData = {
                string contains = "1681 plaques ground referencees depuis les assets fournis"
                string grid = "41 x 41 diagonal staggered"
                string spacing = "3.35 x 3.10 units, row shifted diagonally"
                string assets = "PP_Meadow_07, PP_Meadow_08, PP_Meadow_Path_05"
            }
        )
        {
            def Xform "GroundTiles_41x41_DiagonalStaggered"
            {
                def Xform "MeadowTile_R00_C00" (
                    customData = {
                        string category = "GroundMeadow"
                        string zone = "ForestGround"
                        string note = "diagonal_staggered_grid_close_rows_path_rotated_90"
                    }
                )
                {
                    double3 xformOp:translate = (-68.500, 0.000, -62.000)
                    double3 xformOp:rotateXYZ = (0.000, 0.000, 0.000)
                    double3 xformOp:scale = (1.090, 1.090, 1.090)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

                    def "Asset" (
                        instanceable = true
                        prepend references = @AssetesUSD/Ground/PP_Meadow_08.usda@</PP_Meadow_08_828>
                    )
