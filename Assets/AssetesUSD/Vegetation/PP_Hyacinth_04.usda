                    float2 outputs:result
                }

                def Shader "_MainTex"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (0, 0, 0, 0)
                    float4 inputs:fallback = (0, 0, 0, 1)
                    asset inputs:file = @PP_Color_Palette.png@
                    token inputs:isSRGB = "auto"
                    float4 inputs:scale = (1, 1, 1, 1)
                    token inputs:sourceColorSpace = "auto"
                    float2 inputs:st = (0, 0)
                    float2 inputs:st.connect = </PP_Hyacinth_04_744/Materials/PP_Standard_Material_52838/PreviewSurface/uvReader.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:a
                    float outputs:b
                    float outputs:g
                    float outputs:r
                    float3 outputs:rgb
                    float4 outputs:rgba
                }
            }
        }
    }
}

